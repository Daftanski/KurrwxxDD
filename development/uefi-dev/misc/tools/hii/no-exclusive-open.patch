+/// Open a protocol on a driver handle without taking it over.
+/// EXCLUSIVE would disconnect every driver using the handle (SNP, MNP, IP...).
+pub fn open_shared<P: ProtocolPointer + ?Sized>(handle: Handle) -> uefi::Result<ScopedProtocol<P>> {
+    let params = OpenProtocolParams { handle, agent: boot::image_handle(), controller: None };
+    // SAFETY: the protocol is only read while the driver stays loaded.
+    unsafe { boot::open_protocol::<P>(params, OpenProtocolAttributes::GetProtocol) }
+}
